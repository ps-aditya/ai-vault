{
  "manifest_version": 3,
  "name": "AI Vault - Save to Markdown",
  "version": "1.0.0",
  "description": "Highlight text on Claude or ChatGPT, hit Save. It becomes a file on your computer.",
  "permissions": ["downloads", "activeTab", "scripting", "notifications", "storage"],
  "host_permissions": ["https://claude.ai/*", "https://chatgpt.com/*"],
  "options_page": "options.html",
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://claude.ai/*", "https://chatgpt.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "save-selection": {
      "suggested_key": {
        "default": "Ctrl+Shift+S",
        "mac": "Command+Shift+S"
      },
      "description": "Save current selection to AI Vault"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "AI Vault - highlight text, hit Save (or Ctrl+Shift+S)"
  }
}
